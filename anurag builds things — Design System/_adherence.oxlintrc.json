{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "reference/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Atkinson Hyperlegible Mono|Fraunces|Inter Tight|JetBrains Mono|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Atkinson Hyperlegible Mono, Fraunces, Inter Tight, JetBrains Mono, Newsreader."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--display",
      "--dur-fast",
      "--dur-mid",
      "--dur-slow",
      "--ease",
      "--ease-pulse",
      "--frame-max",
      "--fs-base",
      "--fs-body",
      "--fs-dek",
      "--fs-h2",
      "--fs-h3",
      "--fs-hero",
      "--fs-lede",
      "--fs-list",
      "--fs-listing",
      "--fs-mono-cat",
      "--fs-mono-code",
      "--fs-mono-lbl",
      "--fs-mono-meta",
      "--fs-prevnext",
      "--fs-small",
      "--fs-title-home",
      "--fs-title-post",
      "--fs-ui",
      "--fs-ui-s",
      "--fw-light",
      "--fw-medium",
      "--fw-regular",
      "--gutter",
      "--halo-signal",
      "--ink",
      "--ink-2",
      "--ink-3",
      "--ink-4",
      "--lh-display",
      "--lh-prose",
      "--lh-tight",
      "--lh-title",
      "--lh-ui",
      "--ls-display",
      "--ls-hero",
      "--ls-mono-cat",
      "--ls-mono-loose",
      "--ls-mono-mid",
